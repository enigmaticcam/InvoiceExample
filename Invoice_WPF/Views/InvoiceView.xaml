<UserControl x:Class="Invoice_WPF.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Invoice_WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                FontSize="20"
                Text="Header" />
            <TextBlock
                Grid.Column="0"
                Grid.Row="1"
                Text="Header Id"/>
            <TextBox 
                Grid.Column="1"
                Grid.Row="1"
                Text="{Binding Header.InvoiceHeaderId}"
                IsReadOnly="true"/>
            <TextBlock
                Grid.Column="0"
                Grid.Row="2"
                Text="Customer" />
            <TextBox 
                Grid.Column="1"
                Grid.Row="2"
                Text="{Binding Header.Customer}"
                IsReadOnly="true"/>
            <TextBlock 
                Grid.Column="0"
                Grid.Row="3"
                Text="Invoice date" />
            <TextBox 
                Grid.Column="1"
                Grid.Row="3"
                Text="{Binding Header.InvoiceDate}"
                IsReadOnly="true"/>
            <TextBlock 
                Grid.Column="0"
                Grid.Row="4"
                Text="Status Type" />
            <TextBox 
                Grid.Column="1"
                Grid.Row="4"
                Text="{Binding StatusTypeText, Mode=OneWay}"
                IsReadOnly="true"/>
            <TextBlock 
                Grid.Column="0"
                Grid.Row="5"
                Text="Description" />
            <TextBox 
                Grid.Column="1"
                Grid.Row="5"
                Text="{Binding Header.Description}"
                IsReadOnly="true"/>
        </Grid>
    </Grid>
</UserControl>
