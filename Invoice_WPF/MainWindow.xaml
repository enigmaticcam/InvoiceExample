<Window x:Class="Invoice_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Invoice_WPF" xmlns:views="clr-namespace:Invoice_WPF.Views"
        xmlns:vms="clr-namespace:Invoice_WPF.ViewModels"
        xmlns:modal="clr-namespace:ModalControl;assembly=ModalControl"
        xmlns:conv="clr-namespace:Invoice_WPF.Converters"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="600" 
        Width="800"
        FontSize="14">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20 10">
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:InvoiceSearchViewModel}">
                <views:InvoiceSearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MainMenuViewModel}">
                <views:MainMenuView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:InvoiceViewModel}">
                <views:InvoiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:InvoiceUploaderViewModel}">
                <views:InvoiceUploaderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:InvoiceRandomViewModel}">
                <views:InvoiceRandomView />
            </DataTemplate>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel 
            Grid.Column="0"
            Grid.Row="0"
            Orientation="Vertical">
            <Button 
                Content="Invoice Search" 
                Command="{Binding OpenInvoiceSearchCommand}"
                IsEnabled="{Binding IsNotRunning}"
                />
            <Button 
                Content="Invoice Uploader" 
                Command="{Binding OpenInvoiceUploaderCommand}"
                IsEnabled="{Binding IsNotRunning}"
                />
        </StackPanel>
        <ContentControl
            Margin="20 0"
            Grid.Column="1"
            Grid.Row="0"
            Content="{Binding CurrentViewModel}"/>
        <modal:Modal
            Panel.ZIndex="1"
            Grid.Column="1"
            IsOpen="{Binding IsModalOpen}">
            <ContentControl Content="{Binding CurrentModalViewModel}"/>
        </modal:Modal>
        <StackPanel
            Grid.Column="1"
            Grid.Row="1"
            Orientation="Vertical"
            Visibility="{Binding LastResultSetHasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Text="The following errors occurred:"/>
            <ListView
                Grid.Column="1"
                Grid.Row="1"
                ItemsSource="{Binding LastResultSet}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Error">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
