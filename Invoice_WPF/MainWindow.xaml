<Window x:Class="Invoice_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Invoice_WPF" xmlns:views="clr-namespace:Invoice_WPF.Views"
        xmlns:vms="clr-namespace:Invoice_WPF.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" 
        Width="800"
        MaxWidth="600"
        FontSize="14">
    <Grid Margin="20 10">
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:InvoiceSearchViewModel}">
                <views:InvoiceSearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MainMenuViewModel}">
                <views:MainMenuView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:InvoiceViewModel}">
                <views:InvoiceView />
            </DataTemplate>
        </Grid.Resources>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
