@page "/invoice/{id:int}"
@inject IDialogService _dialog
@inject NavigationManager _navigation
@inject IInvoiceDetailInvoker _invoiceDetailInvoker
@inject IInvoiceDetailState _invoiceDetailState
@inject IInvoiceDetailUpdateState _invoiceDetailUpdateState
@inject IInvoiceHeaderInvoker _invoiceHeaderInvoker
@inject IInvoiceHeaderState _invoiceHeaderState
@inject IResultStatusTypeInvoker _resultStatusTypeInvoker
@inject IResultStatusTypeState _resultStatusTypeState
@inject IStatusTypeInvoker _statusTypeInvoker
@inject IStatusTypeState _statusTypeState

<ResponseMessage Token="_token" @ref="_message" />

<PageState LoadFunction="LoadData" Token="_token">
    @if (_invoiceHeader != null)
    {
        @if (!string.IsNullOrWhiteSpace(StatusText))
        {
            <MudAlert Severity="Severity.Info">
                @StatusText
            </MudAlert>
        }

        @* Title *@

        <MudPaper Elevation="0" class="pa-4">
            <MudText Typo="Typo.h6">Invoice</MudText>
        </MudPaper>

        @* Menu *@

        <MudPaper Elevation="0" Style="background-color: lightgray">
            <MudMenu Label="Actions" Disabled="Disabled()" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                @if (CanEdit)
                {
                    @if (CanDelete)
                    {
                        <MudMenuItem Label="Delete" OnClick="OnDelete" />
                    }
                    <MudMenuItem Label="Refresh Results" OnClick="OnRefreshResults" />
                }
                @if (CanChangeStatus)
                {
                    @foreach (var status in StatusChanges)
                    {
                        <MudMenuItem OnClick="() => OnChangeStatus(status)" Disabled="Disabled()">Change Status to @_statusTypeState.GetText(status)</MudMenuItem>
                    }
                }
            </MudMenu>
        </MudPaper>

        @* Progress *@

        @if (Disabled())
        {
            <MudPaper Elevation="0" Class="pa-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            </MudPaper>
        }

        <MudPaper Elevation="0" class="pa-4" Outlined="false">
            <MudExpansionPanels MultiExpansion="true">
                                
                @* Header *@

                <MudExpansionPanel Text="Header" Expanded="true">
                    <MudGrid Spacing="1">
                        <MudItem xs="3">
                            <MudTextField @bind-Value="_invoiceHeader.InvoiceHeaderId" Label="Header Id" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="_invoiceHeader.Customer" Label="Customer" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="_invoiceHeader.InvoiceDate" Label="Date" ReadOnly="true" Format="yyyy-MM-dd" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                
                @* Summary *@

                <MudExpansionPanel Text="Summary" Expanded="true">
                    <MudGrid Spacing="0">
                        <MudItem xs="2">
                            <MudPaper Square="true" Elevation="0" Outlined="true">
                                <MudTextField @bind-Value="_summary.TotalRequestedDollars" ReadOnly="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Format="N2" />
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">Total Requested Dollars</MudItem>
                        <MudFlexBreak />
                        <MudItem xs="2">
                            <MudPaper Square="true" Elevation="0" Outlined="true">
                                <MudTextField @bind-Value="_summary.TotalExceptionDollars" ReadOnly="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Format="N2" />
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">Total Exception Dollars</MudItem>
                        <MudFlexBreak />
                        <MudItem xs="2">
                            <MudPaper Square="true" Elevation="0" Outlined="true">
                                <MudTextField @bind-Value="_summary.TotalAgreedDollars" ReadOnly="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Format="N2" />
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">Total Agreed Dollars</MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                @* Detail *@

                <MudExpansionPanel Text="Detail">

                    @* Edit button *@

                    @if (CanEdit)
                    {
                        if (_isEditing)
                        {
                            <MudIconButton OnClick="OnCancelUpdate" Disabled="Disabled()" Icon="@Icons.Material.Filled.Cancel" />
                            <MudIconButton OnClick="OnUpdateLines" Disabled="Disabled()" Color="Color.Primary" Icon="@Icons.Material.Filled.Save" />
                        }
                        else
                        {
                            <MudIconButton onclick="() => _isEditing = !_isEditing" Disabled="Disabled()" Icon="@Icons.Material.Filled.Edit" />
                        }
                    }

                    @* Detail Grid *@

                    <MudChip T="string" Style="@LineColor(false, true)">Case Failure</MudChip>
                    <MudChip T="string" Style="@LineColor(true, false)">Rate Failure</MudChip>
                    <MudChip T="string" Style="@LineColor(true, true)">Case and Rate Failure</MudChip>
                    <MudDataGrid T="DTO_InvoiceDetail" Items="_invoiceDetailState.Items" Height="600px" FixedHeader="true" Filterable="true" FilterMode="DataGridFilterMode.Simple"
                                 SortMode="SortMode.Single" FixedFooter="true" EditMode="DataGridEditMode.Cell" ReadOnly="!CanEdit || !_isEditing" RowStyleFunc="RowStyle" Dense="true"
                                 CommittedItemChanged="OnCommitedChanged">
                        <Columns>
                            <TemplateColumn Editable="false">
                                <CellTemplate>
                                    @if (_isEditing)
                                    {
                                        if (CanPay(context.Item))
                                        {
                                            <MudTooltip Text="Pay">
                                                <MudIconButton OnClick="() => OnPayLine(context.Item)" Disabled="Disabled()" Icon="@Icons.Material.Filled.AttachMoney" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="Unpay">
                                                <MudIconButton OnClick="() => OnRemovePayLine(context.Item)" Disabled="Disabled()" Icon="@Icons.Material.Filled.MoneyOff" />
                                            </MudTooltip>
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.InvoiceDetailId" Title="Id" Editable="false" />
                            <PropertyColumn Property="x => x.CustItemCode" Title="Cust Item Code" Editable="false" />
                            <PropertyColumn Property="x => x.CustItemDesc" Title="Cust Item Desc" Editable="false" />
                            <PropertyColumn Property="x => x.Cases" Title="Cases" Editable="false" />
                            <PropertyColumn Property="x => x.CustomerRate" Title="Cust Rate" Editable="false" />
                            <PropertyColumn Property="x => x.ApprovedRate" Title="Approved Rate" Editable="true" />
                            <PropertyColumn Property="x => x.HasFailedCase" Title="Case Failure" Editable="false" />
                            <PropertyColumn Property="x => x.HasFailedRate" Title="Rate Failure" Editable="false" />
                            <PropertyColumn Property="x => x.ResultStatusTypeId" Title="Result" Editable="false">
                                <CellTemplate>
                                    @_resultStatusTypeState.GetText(context.Item.ResultStatusTypeId ?? -1)
                                </CellTemplate>
                            </PropertyColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="DTO_InvoiceDetail" />
                        </PagerContent>
                    </MudDataGrid>
                </MudExpansionPanel>

            </MudExpansionPanels>
        </MudPaper>
    }
</PageState>






